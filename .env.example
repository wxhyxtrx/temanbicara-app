# ============================================================
# TemanBicara — konfigurasi environment
# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN commit .env.local. Variabel berawalan NEXT_PUBLIC_ terlihat di browser,
# jadi jangan pernah taruh kunci rahasia di variabel NEXT_PUBLIC_.
# ============================================================

# ---------- APLIKASI ----------
# Port dev server lokal (dibaca otomatis oleh Next.js).
PORT=3000
# development | production
NODE_ENV=development
# Alamat publik aplikasi tanpa garis miring di akhir. Lokal: http://localhost:3000,
# produksi: domain Vercel. Dipakai untuk redirect setelah bayar (Midtrans callbacks.finish).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- KEAMANAN SESI ----------
# WAJIB. Kunci rahasia untuk menandatangani cookie role (tb_user_role).
# Isi string acak panjang (mis. 64 karakter hex). Kalau kosong, semua user dianggap
# belum login (tidak bisa login sama sekali). Harus sama di semua server/instance.
ROLE_COOKIE_SECRET=

# ---------- SUPABASE ----------
# URL project Supabase (Settings > API). Versi NEXT_PUBLIC_ untuk browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Salinan untuk server (fallback bila NEXT_PUBLIC_ tidak terbaca).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# RAHASIA, hanya server. Melewati RLS — jangan pernah beri prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- PEMBAYARAN (MIDTRANS) ----------
# Client key: dipakai Snap popup di browser (aman terlihat).
NEXT_PUBLIC_PAYMENT_CLIENT_KEY=
# RAHASIA, hanya server: membuat transaksi Snap, cek status, verifikasi webhook.
PAYMENT_SERVER_KEY=
# false = Sandbox (uang mainan), true = Production (uang sungguhan).
# Diteruskan otomatis ke browser lewat next.config.ts. Ubah → wajib redeploy.
PAYMENT_IS_PRODUCTION=false
# Opsional. URL publik webhook untuk transaksi baru (header X-Override-Notification).
# Lokal via Tailscale Funnel: https://<mesin>.<tailnet>.ts.net:8443/api/webhooks/midtrans
# Kosongkan untuk memakai Notification URL di dashboard Midtrans.
PAYMENT_NOTIFICATION_URL=

# ---------- CRON / PENJADWALAN ----------
# Kunci rahasia untuk Vercel Cron. Dikirim via header Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# ---------- BELUM DIPAKAI KODE (cadangan) ----------
# Variabel di bawah tidak dibaca kode saat ini. Boleh dibiarkan kosong.
# Hapus dari sini kalau dipastikan tidak akan dipakai.
JWT_SECRET=
ADMIN_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
PAYMENT_CLIENT_KEY=
PAYMENT_MERCHANT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
